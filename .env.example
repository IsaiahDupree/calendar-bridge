# CalendarBridge — local config used by the kit (kit/register-connector.mjs),
# the demo recorder, and the e2e test. Copy to .env.local and fill in.
# NEVER commit .env.local. Do NOT put real secrets in THIS file — placeholders only.

# CalendarBridge server base URL (your Vercel deployment, or the hosted one)
NB_SERVER=https://calendarbridge.vercel.app

# The CalendarBridge account the connector signs in as (the reviewer demo account)
NB_EMAIL=reviewer@calendarbridge.demo
NB_PASSWORD=your-calendarbridge-password

# Reviewer demo password, referenced by name (DEMO_PASSWORD) from the OpenAI
# listing config (kit/calendar.openai.config.json). Same value as NB_PASSWORD.
DEMO_PASSWORD=your-calendarbridge-password

# Server-side (Vercel) env — set these in the deployment, not committed.
# Placeholders only; fill real values in .env.local / Vercel project settings.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
JWT_SECRET=your-jwt-secret
